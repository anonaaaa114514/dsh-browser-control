{
  "name": "dsh-browser-control",
  "version": "0.1.0",
  "private": true,
  "description": "Let the DSH agent list, read, and modify pages open in the right-Sidebar browser tabs.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "侧边栏浏览器控制",
    "description": "让 Agent 查看并修改右侧边栏里打开的浏览器页面内容。"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
